# Godot logs and user data during dev
*.log
logs/

# Steam / GodotSteam
# The redistributable steam_api*.dll / .so / .dylib from Steamworks SDK
# are typically placed in the project (addons/godotsteam/...) and committed.
# Do NOT commit your personal steam_appid.txt for published builds (Valve recommends against it).
# Keep a steam_appid.txt.example instead.
steam_appid.txt

# Large binary assets - consider Git LFS for these in real production
# *.glb
# *.gltf
# *.ogg
# *.wav
# *.png (large textures)
# *.jpg

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary / backup
*~
*.bak
*.tmp

# Project-specific
# Add your own large asset dirs or generated files here if needed

# GdUnit4 test reports (generated by headless runs)
reports/

# godot-mcp server (vendored clone, rebuildable - see docs/TESTING.md)
tools/godot-mcp/

# Repo-local scratch space for temporary files (downloads, experiments)
.scratch/
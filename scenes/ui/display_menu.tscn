theme_override_font_sizes/font_size = 22
text = "Display"
horizontal_alignment = 1

[node name="Help" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Resolution = game window size (and 3D pixel count). UI scale = menu/HUD magnification. Stretch uses a fixed 1920x1080 design base so UI fills the window without a letterbox panel. IMPORTANT: with the game EMBEDDED in the editor Game dock, the OS cannot resize — turn OFF Game → Embed Game on Next Play, then Play again."
autowrap_mode = 3

[node name="Grid" type="GridContainer" parent="Panel/Margin/VBox"]
